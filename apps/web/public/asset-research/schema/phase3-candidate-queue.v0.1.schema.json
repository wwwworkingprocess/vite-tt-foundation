{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "./phase3-candidate-queue.v0.1.schema.json",
  "title": "Phase 3 Candidate Queue v0.1",
  "type": "object",
  "required": [
    "schemaVersion",
    "generatedAt",
    "queue"
  ],
  "properties": {
    "schemaVersion": {
      "const": "0.1.0"
    },
    "generatedAt": {
      "type": "string"
    },
    "queue": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "rank",
          "questionId",
          "title",
          "disposition",
          "priority",
          "cityIds",
          "zoneCount",
          "sharedFamilyIds"
        ],
        "properties": {
          "rank": {
            "type": "integer",
            "minimum": 1
          },
          "questionId": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "disposition": {
            "type": "string"
          },
          "priority": {
            "type": "string",
            "enum": [
              "critical",
              "high",
              "medium",
              "low"
            ]
          },
          "cityIds": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "zoneCount": {
            "type": "integer",
            "minimum": 0
          },
          "sharedFamilyIds": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
