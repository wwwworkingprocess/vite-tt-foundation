{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Foundation Template Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "templateName",
    "templateVersion",
    "referenceProject",
    "runtime",
    "foundationPaths",
    "publicEntryPoints",
    "schemaVersions",
    "buildBudgetsBytes",
    "extensionPoints",
    "contractVersions",
    "bootstrapCommands",
    "portableValidationCommand",
    "releaseRepositoryValidationCommands",
    "renameSurfaces",
    "protectedCompatibilitySurfaces",
    "archiveExcludes"
  ],
  "properties": {
    "$schema": { "type": "string" },
    "templateName": { "type": "string", "minLength": 1 },
    "templateVersion": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "referenceProject": { "type": "string", "minLength": 1 },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["node", "yarn"],
      "properties": {
        "node": { "const": "24.18.0" },
        "yarn": { "const": "4.17.1" }
      }
    },
    "foundationPaths": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "publicEntryPoints": {
      "type": "array",
      "minItems": 2,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "schemaVersions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "simulationSnapshot",
        "saveRecord",
        "transportSimulationSnapshot",
        "transportSaveRecord"
      ],
      "properties": {
        "simulationSnapshot": { "const": 1 },
        "saveRecord": { "const": 1 },
        "transportSimulationSnapshot": { "const": 1 },
        "transportSaveRecord": { "const": 1 }
      }
    },
    "contractVersions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "protocolContract",
        "workerAdapterContract",
        "transportClientContract"
      ],
      "properties": {
        "protocolContract": { "const": 1 },
        "workerAdapterContract": { "const": 1 },
        "transportClientContract": { "const": 1 }
      }
    },
    "buildBudgetsBytes": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "applicationEntry",
        "representation",
        "worker",
        "transportWorker",
        "totalEmittedJavaScript"
      ],
      "properties": {
        "applicationEntry": { "type": "integer", "minimum": 1 },
        "representation": { "type": "integer", "minimum": 1 },
        "worker": { "type": "integer", "minimum": 1 },
        "transportWorker": { "type": "integer", "minimum": 1 },
        "totalEmittedJavaScript": { "type": "integer", "minimum": 1 }
      }
    },
    "extensionPoints": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "bootstrapCommands": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "portableValidationCommand": { "const": "corepack yarn validate:portable" },
    "releaseRepositoryValidationCommands": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "renameSurfaces": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "protectedCompatibilitySurfaces": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "archiveExcludes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    }
  }
}
