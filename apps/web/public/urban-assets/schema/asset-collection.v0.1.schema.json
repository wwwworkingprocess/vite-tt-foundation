{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "./asset-collection.v0.1.schema.json",
  "type": "object",
  "required": [
    "schemaVersion",
    "kind",
    "status",
    "items"
  ],
  "properties": {
    "schemaVersion": {
      "const": "0.1.0"
    },
    "scope": {
      "type": "string"
    },
    "settlementId": {
      "type": "string"
    },
    "cityResearchId": {
      "type": "string"
    },
    "kind": {
      "type": "string"
    },
    "status": {
      "type": "string"
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "stage"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "stage": {
            "type": "string",
            "enum": [
              "unmaterialized",
              "proxy-ready",
              "asset-ready",
              "disabled"
            ]
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
