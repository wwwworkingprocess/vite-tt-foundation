{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "./shared-asset-families.v0.1.schema.json",
  "title": "Shared Asset Families Portfolio v0.1",
  "type": "object",
  "required": [
    "schemaVersion",
    "generatedFromCities",
    "sharedBuildingFamilies",
    "sharedPoiFamilies",
    "reconciliationHistory"
  ],
  "properties": {
    "schemaVersion": {
      "const": "0.1.0"
    },
    "generatedFromCities": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "sharedBuildingFamilies": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "memberBuildingIds",
          "commonStructure",
          "cityVariants",
          "reuseRecommendation",
          "confidence",
          "evidence"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "memberBuildingIds": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "commonStructure": {
            "type": "object",
            "required": [
              "storeysTypical",
              "baseForms",
              "roofFamilies",
              "footprintScales",
              "commonUses"
            ],
            "properties": {
              "storeysTypical": {
                "type": "array",
                "minItems": 2,
                "maxItems": 2,
                "items": {
                  "type": [
                    "number",
                    "null"
                  ]
                }
              },
              "baseForms": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "roofFamilies": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "footprintScales": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "commonUses": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "additionalProperties": false
          },
          "cityVariants": {
            "type": "object",
            "additionalProperties": {
              "type": "object",
              "required": [
                "buildingIds",
                "distinguishingTraits",
                "constraints",
                "notes"
              ],
              "properties": {
                "buildingIds": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "distinguishingTraits": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "constraints": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "notes": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              },
              "additionalProperties": false
            }
          },
          "reuseRecommendation": {
            "type": "string"
          },
          "confidence": {
            "type": "string",
            "enum": [
              "high",
              "medium",
              "low"
            ]
          },
          "evidence": {
            "type": "object",
            "required": [
              "sourceCityIds",
              "notes",
              "unresolved"
            ],
            "properties": {
              "sourceCityIds": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "notes": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "unresolved": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    },
    "sharedPoiFamilies": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "memberPoiIds",
          "commonPoiTypes",
          "sharedTreatmentCandidate",
          "citySpecificTraits",
          "confidence",
          "notes"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "memberPoiIds": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "commonPoiTypes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "sharedTreatmentCandidate": {
            "type": "string"
          },
          "citySpecificTraits": {
            "type": "object",
            "additionalProperties": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "confidence": {
            "type": "string",
            "enum": [
              "high",
              "medium",
              "low"
            ]
          },
          "notes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": false
      }
    },
    "reconciliationHistory": {
      "type": "array",
      "items": {
        "type": "object"
      }
    }
  },
  "additionalProperties": false
}
