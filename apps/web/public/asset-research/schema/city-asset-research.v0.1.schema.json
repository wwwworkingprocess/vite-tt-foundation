{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "./city-asset-research.v0.1.schema.json",
  "title": "Settlement Asset Research City Catalog v0.1",
  "type": "object",
  "required": [
    "schemaVersion",
    "city",
    "researchState",
    "sourceRegistry",
    "buildings",
    "pois",
    "researchHistory"
  ],
  "properties": {
    "schemaVersion": {
      "const": "0.1.0"
    },
    "city": {
      "type": "object",
      "required": [
        "id",
        "name",
        "country",
        "region",
        "sourceSettlementMetadataVersion",
        "sourceSettlementMetadataFile"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "country": {
          "type": "string",
          "minLength": 1
        },
        "region": {
          "type": [
            "string",
            "null"
          ]
        },
        "sourceSettlementMetadataVersion": {
          "type": "string",
          "minLength": 1
        },
        "sourceSettlementMetadataFile": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "researchState": {
      "type": "object",
      "required": [
        "stage",
        "baselineCompleted",
        "cityResearchCompleted",
        "lastResearchDate",
        "completeness",
        "openQuestions"
      ],
      "properties": {
        "stage": {
          "$ref": "#/$defs/researchStage"
        },
        "baselineCompleted": {
          "type": "boolean"
        },
        "cityResearchCompleted": {
          "type": "boolean"
        },
        "lastResearchDate": {
          "type": [
            "string",
            "null"
          ]
        },
        "completeness": {
          "type": "string",
          "enum": [
            "partial",
            "substantial",
            "mature"
          ]
        },
        "openQuestions": {
          "$ref": "#/$defs/stringArray"
        }
      },
      "additionalProperties": false
    },
    "sourceRegistry": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "title",
          "sourceType",
          "publisher",
          "url",
          "accessedDate",
          "geographicScope",
          "notes"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "sourceType": {
            "type": "string",
            "enum": [
              "official",
              "planning",
              "heritage",
              "institutional",
              "operator",
              "mapping",
              "aerial-imagery",
              "satellite-imagery",
              "reference",
              "secondary"
            ]
          },
          "publisher": {
            "$ref": "#/$defs/nullableString"
          },
          "url": {
            "$ref": "#/$defs/nullableString"
          },
          "accessedDate": {
            "$ref": "#/$defs/nullableString"
          },
          "geographicScope": {
            "$ref": "#/$defs/nullableString"
          },
          "notes": {
            "$ref": "#/$defs/nullableString"
          }
        },
        "additionalProperties": false
      }
    },
    "buildings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/building"
      }
    },
    "pois": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/poi"
      }
    },
    "researchHistory": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "date",
          "stage",
          "summary",
          "changedBuildingIds",
          "changedPoiIds",
          "sourceIdsAdded",
          "notes"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "date": {
            "type": "string"
          },
          "stage": {
            "$ref": "#/$defs/researchStage"
          },
          "summary": {
            "type": "string"
          },
          "changedBuildingIds": {
            "$ref": "#/$defs/stringArray"
          },
          "changedPoiIds": {
            "$ref": "#/$defs/stringArray"
          },
          "sourceIdsAdded": {
            "$ref": "#/$defs/stringArray"
          },
          "notes": {
            "$ref": "#/$defs/stringArray"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "$defs": {
    "confidence": {
      "type": "string",
      "enum": [
        "high",
        "medium",
        "low"
      ]
    },
    "researchStage": {
      "type": "string",
      "enum": [
        "baseline",
        "gap-analysis",
        "city-reresearch",
        "city-reviewed",
        "portfolio-reconciled"
      ]
    },
    "nullableString": {
      "type": [
        "string",
        "null"
      ]
    },
    "stringArray": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "nullableNumber": {
      "type": [
        "number",
        "null"
      ]
    },
    "geoGeometry": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "required": [
            "type",
            "coordinates"
          ],
          "properties": {
            "type": {
              "type": "string",
              "enum": [
                "Point",
                "MultiPoint",
                "LineString",
                "MultiLineString",
                "Polygon",
                "MultiPolygon"
              ]
            },
            "coordinates": {}
          },
          "additionalProperties": false
        }
      ]
    },
    "evidence": {
      "type": "object",
      "required": [
        "researchStage",
        "confidence",
        "confidenceByAspect",
        "sourceIds",
        "sourceProfileIds",
        "observedFacts",
        "interpretations",
        "inferences",
        "unresolved"
      ],
      "properties": {
        "researchStage": {
          "$ref": "#/$defs/researchStage"
        },
        "confidence": {
          "$ref": "#/$defs/confidence"
        },
        "confidenceByAspect": {
          "type": "object",
          "additionalProperties": {
            "type": [
              "string",
              "null"
            ],
            "enum": [
              "high",
              "medium",
              "low",
              null
            ]
          }
        },
        "sourceIds": {
          "$ref": "#/$defs/stringArray"
        },
        "sourceProfileIds": {
          "$ref": "#/$defs/stringArray"
        },
        "observedFacts": {
          "$ref": "#/$defs/stringArray"
        },
        "interpretations": {
          "$ref": "#/$defs/stringArray"
        },
        "inferences": {
          "$ref": "#/$defs/stringArray"
        },
        "unresolved": {
          "$ref": "#/$defs/stringArray"
        }
      },
      "additionalProperties": false
    },
    "building": {
      "type": "object",
      "required": [
        "id",
        "catalogKind",
        "name",
        "aliases",
        "reuseScope",
        "identity",
        "function",
        "urbanContext",
        "morphology",
        "appearance",
        "proceduralUse",
        "assetPreparation",
        "evidence"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "catalogKind": {
          "type": "string",
          "enum": [
            "building-family",
            "named-building",
            "landmark-building",
            "infrastructure-building"
          ]
        },
        "name": {
          "type": "string"
        },
        "aliases": {
          "$ref": "#/$defs/stringArray"
        },
        "reuseScope": {
          "type": "string",
          "enum": [
            "shared",
            "regional",
            "city-specific",
            "unique"
          ]
        },
        "identity": {
          "type": "object",
          "required": [
            "sharedArchetypeCandidate",
            "cityProfileIds",
            "districtIds",
            "zoneIds",
            "poiIds"
          ],
          "properties": {
            "sharedArchetypeCandidate": {
              "$ref": "#/$defs/nullableString"
            },
            "cityProfileIds": {
              "$ref": "#/$defs/stringArray"
            },
            "districtIds": {
              "$ref": "#/$defs/stringArray"
            },
            "zoneIds": {
              "$ref": "#/$defs/stringArray"
            },
            "poiIds": {
              "$ref": "#/$defs/stringArray"
            }
          },
          "additionalProperties": false
        },
        "function": {
          "type": "object",
          "required": [
            "dominantUses",
            "secondaryUses",
            "period",
            "currentStatus"
          ],
          "properties": {
            "dominantUses": {
              "$ref": "#/$defs/stringArray"
            },
            "secondaryUses": {
              "$ref": "#/$defs/stringArray"
            },
            "period": {
              "type": "object",
              "required": [
                "earliest",
                "latest",
                "label"
              ],
              "properties": {
                "earliest": {
                  "$ref": "#/$defs/nullableNumber"
                },
                "latest": {
                  "$ref": "#/$defs/nullableNumber"
                },
                "label": {
                  "$ref": "#/$defs/nullableString"
                }
              },
              "additionalProperties": false
            },
            "currentStatus": {
              "type": "string",
              "enum": [
                "existing",
                "existing-transition",
                "planned",
                "under-construction",
                "historic",
                "demolished",
                "unknown"
              ]
            }
          },
          "additionalProperties": false
        },
        "urbanContext": {
          "type": "object",
          "required": [
            "parcelRelationship",
            "streetRelationship",
            "typicalDensity",
            "repetitionBehavior",
            "clusterBehavior"
          ],
          "properties": {
            "parcelRelationship": {
              "type": "string"
            },
            "streetRelationship": {
              "type": "string"
            },
            "typicalDensity": {
              "type": "string",
              "enum": [
                "low",
                "medium",
                "high",
                "mixed",
                "unknown"
              ]
            },
            "repetitionBehavior": {
              "type": "string",
              "enum": [
                "unique",
                "landmark-driven",
                "mixed",
                "locally-repetitive",
                "highly-repetitive"
              ]
            },
            "clusterBehavior": {
              "$ref": "#/$defs/nullableString"
            }
          },
          "additionalProperties": false
        },
        "morphology": {
          "type": "object",
          "required": [
            "storeys",
            "heightM",
            "footprintScale",
            "attachment",
            "baseForms",
            "roofFamilies",
            "orientationBehavior",
            "plotCoverage",
            "setbacksM"
          ],
          "properties": {
            "storeys": {
              "type": "object",
              "required": [
                "min",
                "typicalMin",
                "typicalMax",
                "max"
              ],
              "properties": {
                "min": {
                  "$ref": "#/$defs/nullableNumber"
                },
                "typicalMin": {
                  "$ref": "#/$defs/nullableNumber"
                },
                "typicalMax": {
                  "$ref": "#/$defs/nullableNumber"
                },
                "max": {
                  "$ref": "#/$defs/nullableNumber"
                }
              },
              "additionalProperties": false
            },
            "heightM": {
              "type": "object",
              "required": [
                "min",
                "typical",
                "max"
              ],
              "properties": {
                "min": {
                  "$ref": "#/$defs/nullableNumber"
                },
                "typical": {
                  "$ref": "#/$defs/nullableNumber"
                },
                "max": {
                  "$ref": "#/$defs/nullableNumber"
                }
              },
              "additionalProperties": false
            },
            "footprintScale": {
              "type": "string",
              "enum": [
                "tiny",
                "small",
                "medium",
                "large",
                "very-large",
                "mixed"
              ]
            },
            "attachment": {
              "type": "string",
              "enum": [
                "attached",
                "semi-detached",
                "detached",
                "mixed",
                "unknown"
              ]
            },
            "baseForms": {
              "$ref": "#/$defs/stringArray"
            },
            "roofFamilies": {
              "$ref": "#/$defs/stringArray"
            },
            "orientationBehavior": {
              "$ref": "#/$defs/nullableString"
            },
            "plotCoverage": {
              "type": "object",
              "required": [
                "min",
                "max"
              ],
              "properties": {
                "min": {
                  "$ref": "#/$defs/nullableNumber"
                },
                "max": {
                  "$ref": "#/$defs/nullableNumber"
                }
              },
              "additionalProperties": false
            },
            "setbacksM": {
              "type": "object",
              "required": [
                "frontMin",
                "frontMax",
                "sideMin",
                "sideMax"
              ],
              "properties": {
                "frontMin": {
                  "$ref": "#/$defs/nullableNumber"
                },
                "frontMax": {
                  "$ref": "#/$defs/nullableNumber"
                },
                "sideMin": {
                  "$ref": "#/$defs/nullableNumber"
                },
                "sideMax": {
                  "$ref": "#/$defs/nullableNumber"
                }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        },
        "appearance": {
          "type": "object",
          "required": [
            "wallMaterials",
            "wallPalette",
            "roofMaterials",
            "roofPalette",
            "facadeFeatures",
            "balconyBehavior",
            "windowRhythm",
            "cornerTreatment",
            "siteFeatures",
            "silhouetteNotes"
          ],
          "properties": {
            "wallMaterials": {
              "$ref": "#/$defs/stringArray"
            },
            "wallPalette": {
              "$ref": "#/$defs/stringArray"
            },
            "roofMaterials": {
              "$ref": "#/$defs/stringArray"
            },
            "roofPalette": {
              "$ref": "#/$defs/stringArray"
            },
            "facadeFeatures": {
              "$ref": "#/$defs/stringArray"
            },
            "balconyBehavior": {
              "$ref": "#/$defs/nullableString"
            },
            "windowRhythm": {
              "$ref": "#/$defs/nullableString"
            },
            "cornerTreatment": {
              "$ref": "#/$defs/nullableString"
            },
            "siteFeatures": {
              "$ref": "#/$defs/stringArray"
            },
            "silhouetteNotes": {
              "$ref": "#/$defs/nullableString"
            }
          },
          "additionalProperties": false
        },
        "proceduralUse": {
          "type": "object",
          "required": [
            "frequency",
            "placementMode",
            "minimumVisualVariants",
            "variationAxes",
            "mustRemainConsistent",
            "mustVary",
            "placementRules",
            "exclusionRules",
            "populationResponse"
          ],
          "properties": {
            "frequency": {
              "type": "string",
              "enum": [
                "rare",
                "occasional",
                "common",
                "dominant"
              ]
            },
            "placementMode": {
              "type": "string",
              "enum": [
                "procedural",
                "reserved-site",
                "landmark-only"
              ]
            },
            "minimumVisualVariants": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0
            },
            "variationAxes": {
              "$ref": "#/$defs/stringArray"
            },
            "mustRemainConsistent": {
              "$ref": "#/$defs/stringArray"
            },
            "mustVary": {
              "$ref": "#/$defs/stringArray"
            },
            "placementRules": {
              "$ref": "#/$defs/stringArray"
            },
            "exclusionRules": {
              "$ref": "#/$defs/stringArray"
            },
            "populationResponse": {
              "$ref": "#/$defs/nullableString"
            }
          },
          "additionalProperties": false
        },
        "assetPreparation": {
          "type": "object",
          "required": [
            "recommendedTreatment",
            "assetPriority",
            "recognitionImportance",
            "lodNotes",
            "instancingCandidate",
            "futureProductionNotes"
          ],
          "properties": {
            "recommendedTreatment": {
              "type": "string",
              "enum": [
                "shared-kit",
                "regional-variant",
                "city-variant",
                "bespoke-model",
                "procedural-assembly",
                "coarse-massing"
              ]
            },
            "assetPriority": {
              "type": "string",
              "enum": [
                "critical",
                "high",
                "medium",
                "low"
              ]
            },
            "recognitionImportance": {
              "type": "string",
              "enum": [
                "city-defining",
                "district-defining",
                "supporting",
                "background"
              ]
            },
            "lodNotes": {
              "$ref": "#/$defs/nullableString"
            },
            "instancingCandidate": {
              "type": [
                "boolean",
                "null"
              ]
            },
            "futureProductionNotes": {
              "$ref": "#/$defs/stringArray"
            }
          },
          "additionalProperties": false
        },
        "evidence": {
          "$ref": "#/$defs/evidence"
        }
      },
      "additionalProperties": false
    },
    "poi": {
      "type": "object",
      "required": [
        "id",
        "name",
        "aliases",
        "poiType",
        "poiSubtype",
        "associatedBuildingIds",
        "districtIds",
        "zoneIds",
        "location",
        "significance",
        "gameSemantics",
        "assetPreparation",
        "evidence"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "aliases": {
          "$ref": "#/$defs/stringArray"
        },
        "poiType": {
          "type": "string",
          "enum": [
            "civic",
            "heritage",
            "tourism",
            "transport",
            "commercial",
            "recreation",
            "education",
            "health",
            "industrial",
            "port",
            "natural",
            "landscape",
            "religious",
            "sports",
            "cultural",
            "other"
          ]
        },
        "poiSubtype": {
          "$ref": "#/$defs/nullableString"
        },
        "associatedBuildingIds": {
          "$ref": "#/$defs/stringArray"
        },
        "districtIds": {
          "$ref": "#/$defs/stringArray"
        },
        "zoneIds": {
          "$ref": "#/$defs/stringArray"
        },
        "location": {
          "type": "object",
          "required": [
            "type",
            "geometry",
            "geometryQuality"
          ],
          "properties": {
            "type": {
              "type": "string",
              "enum": [
                "Point",
                "MultiPoint",
                "LineString",
                "MultiLineString",
                "Polygon",
                "MultiPolygon"
              ]
            },
            "geometry": {
              "$ref": "#/$defs/geoGeometry"
            },
            "geometryQuality": {
              "type": "string",
              "enum": [
                "official",
                "surveyed",
                "mapped",
                "research-approximation",
                "semantic-association",
                "unknown"
              ]
            }
          },
          "additionalProperties": false
        },
        "significance": {
          "type": "object",
          "required": [
            "scope",
            "visualProminence",
            "identityImportance"
          ],
          "properties": {
            "scope": {
              "type": "string",
              "enum": [
                "local",
                "district",
                "citywide",
                "regional",
                "national",
                "international"
              ]
            },
            "visualProminence": {
              "type": "string",
              "enum": [
                "low",
                "medium",
                "high",
                "skyline"
              ]
            },
            "identityImportance": {
              "type": "string",
              "enum": [
                "supporting",
                "characteristic",
                "city-defining"
              ]
            }
          },
          "additionalProperties": false
        },
        "gameSemantics": {
          "$ref": "#/$defs/stringArray"
        },
        "assetPreparation": {
          "type": "object",
          "required": [
            "recommendedTreatment",
            "assetPriority",
            "requiresUniqueGeometry",
            "futureProductionNotes"
          ],
          "properties": {
            "recommendedTreatment": {
              "type": "string",
              "enum": [
                "marker-only",
                "procedural-context",
                "bespoke-object",
                "bespoke-complex",
                "landscape-feature"
              ]
            },
            "assetPriority": {
              "type": "string",
              "enum": [
                "critical",
                "high",
                "medium",
                "low"
              ]
            },
            "requiresUniqueGeometry": {
              "type": [
                "boolean",
                "null"
              ]
            },
            "futureProductionNotes": {
              "$ref": "#/$defs/stringArray"
            }
          },
          "additionalProperties": false
        },
        "evidence": {
          "$ref": "#/$defs/evidence"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
