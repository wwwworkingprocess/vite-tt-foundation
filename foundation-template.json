{
  "$schema": "./docs/template/foundation-template.schema.json",
  "templateName": "Foundation Template",
  "templateVersion": "1.0.0",
  "referenceProject": "Torrevieja Tycoon",
  "runtime": {
    "node": "24.18.0",
    "yarn": "4.17.1"
  },
  "foundationPaths": [
    "packages/simulation",
    "packages/protocol",
    "apps/web/src/simulation-host",
    "apps/web/src/simulation-worker",
    "apps/web/src/persistence",
    "apps/web/src/application",
    "apps/web/src/pacing"
  ],
  "publicEntryPoints": [
    "@torrevieja-tycoon/simulation",
    "@torrevieja-tycoon/protocol"
  ],
  "schemaVersions": {
    "simulationSnapshot": 1,
    "saveRecord": 1
  },
  "contractVersions": {
    "protocolContract": 1,
    "workerAdapterContract": 1
  },
  "buildBudgetsBytes": {
    "applicationEntry": 400000,
    "representation": 1200000,
    "worker": 100000,
    "totalEmittedJavaScript": 1550000
  },
  "extensionPoints": [
    "simulation-state-and-snapshot",
    "simulation-commands",
    "protocol-contracts",
    "host-publications",
    "application-orchestration",
    "representation",
    "validated-scenario-data"
  ],
  "bootstrapCommands": ["corepack yarn install --immutable"],
  "portableValidationCommand": "corepack yarn validate:portable",
  "releaseRepositoryValidationCommands": [
    "corepack yarn audit:tracked",
    "corepack yarn audit:repository"
  ],
  "renameSurfaces": [
    "repository-name",
    "root-package-name",
    "workspace-package-namespace",
    "visible-title",
    "pwa-metadata",
    "shell-default-identifiers",
    "readme-branding",
    "ci-artifact-names"
  ],
  "protectedCompatibilitySurfaces": [
    "protocol-message-discriminators",
    "snapshot-kind-and-schema-version",
    "save-kind-and-schema-version",
    "lifecycle-state-semantics",
    "authoritative-coordinate-meanings",
    "idempotency-semantics"
  ],
  "archiveExcludes": [
    ".git",
    "node_modules",
    "dist",
    "coverage",
    ".vite",
    "cypress/screenshots",
    "cypress/videos",
    "cypress/downloads",
    ".yarn/install-state.gz",
    ".env",
    ".env.*",
    ".env.local",
    "*.log"
  ]
}
