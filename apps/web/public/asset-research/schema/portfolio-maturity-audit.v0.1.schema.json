{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "./portfolio-maturity-audit.v0.1.schema.json",
  "title": "Portfolio Asset Research Maturity Audit v0.1",
  "type": "object",
  "required": [
    "schemaVersion",
    "auditDate",
    "basis",
    "portfolioResearchState",
    "cities",
    "zoneMaturityTotals",
    "sharedBuildingFamilyCount",
    "sharedPoiFamilyCount",
    "candidatePhase3FamilyDecisionZones",
    "conclusion"
  ],
  "properties": {
    "schemaVersion": {
      "const": "0.1.0"
    },
    "auditDate": {
      "type": "string"
    },
    "basis": {
      "type": "string"
    },
    "portfolioResearchState": {
      "type": "string"
    },
    "cities": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "zoneMaturityTotals": {
      "type": "object",
      "additionalProperties": {
        "type": "integer",
        "minimum": 0
      }
    },
    "sharedBuildingFamilyCount": {
      "type": "integer",
      "minimum": 0
    },
    "sharedPoiFamilyCount": {
      "type": "integer",
      "minimum": 0
    },
    "candidatePhase3FamilyDecisionZones": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "conclusion": {
      "type": "string"
    }
  },
  "additionalProperties": false
}
